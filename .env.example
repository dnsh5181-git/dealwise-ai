# Copy this file to ".env" (gitignored) and fill in your values.
# The app auto-loads .env at startup.

# Enables the optional LLM narration layer for the AI assistant.
# Without it, the assistant uses its grounded deterministic text.
ANTHROPIC_API_KEY=

# Optional: model for narration (default: claude-opus-4-8).
# DEALWISE_LLM_MODEL=claude-haiku-4-5
