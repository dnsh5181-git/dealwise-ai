# Copy this file to ".env" (gitignored) and fill in your values.
# The app auto-loads .env at startup.

# Enables the optional LLM narration layer for the AI assistant.
# Without it, the assistant uses its grounded deterministic text.
ANTHROPIC_API_KEY=

# Optional: model for narration (default: claude-opus-4-8).
# DEALWISE_LLM_MODEL=claude-haiku-4-5

# Google Shopping aggregator via Serper (https://serper.dev) — the DEFAULT real
# provider. One key returns real offers from MANY US stores (Walmart, Target,
# Amazon, Best Buy, ...) in a single call — the practical way to cover retailers
# with no free product API. Free tier ~2,500 queries/month.
SERPER_API_KEY=

# eBay (optional). Free Developer Program, but it may reject personal-email
# registrations. Create an app at https://developer.ebay.com and copy the
# PRODUCTION keyset:  App ID -> EBAY_CLIENT_ID,  Cert ID -> EBAY_CLIENT_SECRET
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Best Buy Product API key (https://developer.bestbuy.com). Real US retailer, but
# Best Buy now requires a BUSINESS/custom-domain email (no Gmail/.edu) to issue a key.
BESTBUY_API_KEY=

# Optional: comma-separated queries for the scheduled price refresh.
# DEALWISE_TRACKED=air fryer,65 inch tv,laptop
